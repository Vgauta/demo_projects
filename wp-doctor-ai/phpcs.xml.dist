<?xml version="1.0"?>
<ruleset name="WP Doctor AI">
    <description>WordPress Coding Standards preparation for WP Doctor AI.</description>
    <file>.</file>
    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>node_modules/*</exclude-pattern>
    <arg value="sp"/>
    <config name="testVersion" value="7.4-"/>
    <rule ref="WordPress"/>
    <rule ref="WordPress-Extra"/>
    <rule ref="WordPress-Docs"/>
</ruleset>
